# Copy to .env (never commit .env). Build-time and server-only values.
PIPER_VOICES_DIR=./voices
# Phase 3: Supabase (server-side upload only; the browser uses the publishable key)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional providers
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
HF_TOKEN=
